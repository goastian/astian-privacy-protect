{
    "name": "astian-privacy-protect",
    "version": "2.0.5",
    "description": "Lightweight, fast, and secure ad blocker.",
    "main": "index.js",
    "scripts": {
        "build": "webpack --mode=production",
        "dev": "webpack --mode=development --watch",
        "build:firefox": "npm run build && node build-firefox.js",
        "package:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../adblock-firefox.xpi .",
        "test": "jest",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "clean": "rm -rf dist dist-firefox *.xpi *.zip"
    },
    "keywords": [
        "adblocker",
        "privacy",
        "extension",
        "firefox",
        "chromium",
        "astian",
        "midori block",
        "midori browser adblock",
        "adblock extension",
        "adblocker with stats",
        "adblocker with detailed statistics",
        "astian privacy protect",
        "astian adblock",
        "astian adblock extension",
        "astian adblocker",
        "astian privacy"
    ],
    "author": "AdBlock Extension",
    "license": "MPL-2.0",
    "devDependencies": {
        "@types/chrome": "^0.0.254",
        "@types/webextension-polyfill": "^0.10.4",
        "@types/node": "^20.10.0",
        "@types/jest": "^29.5.8",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "jest-dom": "^5.16.5",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "web-ext": "^7.8.0",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.8.1",
        "style-loader": "^3.3.3"
    },
    "dependencies": {
        "@ghostery/adblocker-webextension": "^2.12.1",
        "webextension-polyfill": "^0.10.0"
    }
}
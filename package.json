{
  "name": "midori-privacy-blocker",
  "private": true,
  "version": "2.3.11",
  "type": "module",
  "description": "Lightweight ad & tracker blocker by Astian Inc",
  "scripts": {
    "build:chromium": "make chromium",
    "build:firefox": "make firefox",
    "package:firefox": "npm run build:firefox && node scripts/package-extension.cjs firefox",
    "build:opera": "make opera",
    "build:thunderbird": "make thunderbird",
    "build:mv3:chromium": "make mv3-chromium",
    "build:mv3:edge": "make mv3-edge",
    "build:mv3:firefox": "make mv3-firefox",
    "build:mv3:safari": "make mv3-safari",
    "lint": "eslint --no-warn-ignored --ignore-pattern \"**/lib/\" --ignore-pattern \"**/npm/\" -- \"./src/js/*.js\" \"./src/js/**/*.js\" \"./**/*.json\" \"./platform/**/*.js\"",
    "test": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goastian/midori-privacy.git"
  },
  "author": "Astian, Inc. and Raymond Hill with uBlock Origin contributors",
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/goastian/midori-privacy/issues"
  },
  "homepage": "https://astian.org/",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "@eslint/json": "^0.13.1",
    "eslint": "^9.34.0",
    "eslint-formatter-compact": "^8.40.0",
    "globals": "^15.14.0"
  }
}
